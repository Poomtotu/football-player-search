# Backend runtime environment
# Local development may leave APP_ENV=development and RELOAD_API_KEY empty.
APP_ENV=development

# Production: set a strong secret in the deployment environment.
# Never commit a real secret value.
RELOAD_API_KEY=

# Optional CORS allow-list, comma-separated.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
