# ===========================================================================
# .gitignore — Football Player IR System (Clean Architecture)
# ===========================================================================

# --- Python & Backend Virtual Environments ---
__pycache__/
backend/__pycache__/
backend/app/__pycache__/
*.py[cod]
*$py.class
venv/
backend/venv/
env/
.venv/
build/
# dist/ ← ลบออกเพื่อให้ frontend/dist/ Push ขึ้น GitHub ได้

.pytest_cache/
.coverage
htmlcov/

# --- Frontend & Node.js Build Output ---
node_modules/
frontend/node_modules/
# frontend/dist/ ← อนุญาตให้ Push ขึ้น GitHub เพื่อ Deploy บน Render.com
.vite/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment Variables & Secrets ---
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# อนุญาตให้ push ไฟล์ตัวอย่าง config ได้
!.env.example
!frontend/.env.example
!backend/.env.example

# --- IDEs & Editors ---
.vscode/
.idea/
.serena/
*.swp
*.swo

# --- Operating System Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Local Tools & Logs ---
*.log
tools/


# --- Local browser/debug artifacts from data audits ---
backend/data/chrome_pm_profile/
backend/data/_*.out
backend/data/_*.err
backend/data/_*.html
backend/data/_*.png
backend/data/_*.log

# --- Frontend verification screenshots / one-off visual checks ---
frontend/*_verify*.png
frontend/edge_*.png
frontend/player_style_*.png
frontend/league_strip_*.png
frontend/orbit_*.png
frontend/silhouette_*.png
frontend/radius_verify.png
frontend/spotlight_verify.png
frontend/motion_verify*.png


# --- Unrelated nested project ---
/moonkeybank/
