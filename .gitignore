# ===========================================================================
# .gitignore — Football Player IR System (Clean Architecture)
# ===========================================================================

# --- Python & Backend Virtual Environments ---
__pycache__/
backend/__pycache__/
backend/app/__pycache__/
*.py[cod]
*$py.class
venv/
backend/venv/
env/
.venv/
build/
# dist/ ← ลบออกเพื่อให้ frontend/dist/ Push ขึ้น GitHub ได้

.pytest_cache/
.coverage
htmlcov/

# --- Frontend & Node.js Build Output ---
node_modules/
frontend/node_modules/
# frontend/dist/ ← อนุญาตให้ Push ขึ้น GitHub เพื่อ Deploy บน Render.com
.vite/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment Variables & Secrets ---
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# อนุญาตให้ push ไฟล์ตัวอย่าง config ได้
!.env.example
!frontend/.env.example
!backend/.env.example

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo

# --- Operating System Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Local Tools & Logs ---
*.log
tools/
